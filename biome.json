{
  "$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": { "noUnusedVariables": "error", "noUnusedImports": "error" },
      "suspicious": { "noExplicitAny": "off", "noConsoleLog": "warn" },
      "style": { "useConst": "error", "noParameterAssign": "error", "noNonNullAssertion": "off" },
      "a11y": { "noSvgWithoutTitle": "warn", "useAltText": "warn" }
    }
  },
  "formatter": { "enabled": true, "formatWithErrors": false, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100, "lineEnding": "lf" },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "es5", "semicolons": "always", "jsxQuoteStyle": "single", "bracketSpacing": true, "arrowParentheses": "always" } },
  "files": { "ignoreUnknown": false, "include": ["**", "!dist/**", "!node_modules/**", "!*.config.*", "!coverage/**"], "ignore": ["coverage/**"] }
}
